#include <stdio.h>

int main() {
    float distance;
    int member;          /* 1 = true, 0 = false */
    char memberStr[10];
    float fare = 100;

    printf("Distance: ");
    scanf("%f", &distance);
    printf("Member (true/false): ");
    scanf("%9s", memberStr);
    member = (memberStr[0] == 't' || memberStr[0] == 'T' || memberStr[0] == '1');

    if (distance > 10)
        fare += (distance - 10) * 20;
    if (member)
        fare *= 0.90f;

    printf("Final Fare: ₹%g\n", fare);
    return 0;
}
