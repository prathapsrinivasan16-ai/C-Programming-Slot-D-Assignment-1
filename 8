#include <stdio.h>

int main() {
    int exp, perf;

    printf("Experience: ");
    scanf("%d", &exp);
    printf("Performance: ");
    scanf("%d", &perf);

    if (exp < 3)
        printf("Level: Junior\n");
    else if (exp <= 7) {
        if (perf >= 80)
            printf("Level: Mid-Level\n");
        else
            printf("Level: Junior\n");
    } else {
        if (perf >= 85)
            printf("Level: Senior\n");
        else
            printf("Level: Mid-Level\n");
    }
    return 0;
}
